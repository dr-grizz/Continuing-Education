# Variable explanations and secret handling: deploy/README.md
NODE_ENV=production
HOSTED_DEMO=true
PROTOTYPE_MODE=true
WEB_URL=https://REPLACE_WITH_APP_HOSTNAME.azurewebsites.net
# Public demo: Canvas OAuth is mandatory for both identity modes below.
DEMO_ACCESS_GATE=none
# Optional credentials used only if DEMO_ACCESS_GATE=basic.
DEMO_ACCESS_USERNAME=demo
# Generate a distinct random hex value for EACH placeholder: openssl rand -hex 32
DEMO_ACCESS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
LEARNER_API_TOKEN=REPLACE_WITH_RANDOM_LEARNER_TOKEN
STAFF_API_TOKEN=REPLACE_WITH_RANDOM_STAFF_TOKEN
AUTOMATION_API_TOKEN=REPLACE_WITH_RANDOM_AUTOMATION_TOKEN
# Neon pooled URL, copied from Connect. Preserve all supplied TLS parameters.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
API_URL=http://127.0.0.1:3051
STAFF_AUTH_MODE=canvas
LEARNER_AUTH_MODE=canvas
CANVAS_COURSES_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# App Service configuration (not needed for local verification)
SCM_DO_BUILD_DURING_DEPLOYMENT=false
# Optional Stripe SANDBOX only. Omit both for simulated payments.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Canvas OAuth for existing CU accounts; configure the shared callback in Canvas.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_STAFF_CLIENT_ID=...
CANVAS_STAFF_CLIENT_SECRET=...
CANVAS_STAFF_REDIRECT_URI=https://APP_HOSTNAME/api/auth/canvas/callback
# CANVAS_TOKEN_ENCRYPTION_KEY=...
# MIGRATION_DATABASE_URL belongs only in the migration operator's environment,
# not the App Service. Copy the DIRECT (no -pooler) Neon URL, with TLS enabled.

# Separate paid App Service beta; see docs/hosting/azure-production-plan.md.
# This is a template, not an Azure settings replacement. Apply a reviewed patch.
# DATABASE_URL is ALREADY on the target app: preserve it, do not overwrite it.
NODE_ENV=production
HOSTED_BETA=true
HOSTED_DEMO=false
PROTOTYPE_MODE=true
WEB_URL=https://REPLACE_WITH_NEW_APP_HOSTNAME.azurewebsites.net
API_PORT=3051
API_URL=http://127.0.0.1:3051
# PORT is supplied by App Service; do not set a competing port.
DEMO_ACCESS_GATE=none
STAFF_AUTH_MODE=canvas
LEARNER_AUTH_MODE=canvas
# Generate three DIFFERENT secrets privately: openssl rand -hex 32
LEARNER_API_TOKEN=REPLACE_WITH_NEW_LEARNER_TOKEN
STAFF_API_TOKEN=REPLACE_WITH_NEW_STAFF_TOKEN
AUTOMATION_API_TOKEN=REPLACE_WITH_NEW_AUTOMATION_TOKEN
CANVAS_BASE_URL=https://cedarville.instructure.com
CANVAS_STAFF_CLIENT_ID=REPLACE_WITH_APPROVED_CLIENT_ID
CANVAS_STAFF_CLIENT_SECRET=REPLACE_WITH_TARGET_CLIENT_SECRET
CANVAS_STAFF_REDIRECT_URI=https://REPLACE_WITH_NEW_APP_HOSTNAME.azurewebsites.net/api/auth/canvas/callback
STAFF_SESSION_HOURS=8
LEARNER_SESSION_HOURS=8
CANVAS_STAFF_FORCE_LOGIN=false
CANVAS_USER_AGENT=Cedarville-CE-Portal/0.1.0
CANVAS_COURSES_ENABLED=false
CANVAS_COURSES_INCLUDE_SUBACCOUNTS=false
# Enable only after account/scope approval and encryption-key configuration:
# CANVAS_COURSES_SUBACCOUNT_ID=49
# CANVAS_STAFF_LOOKUP_ACCOUNT_ID=49
# CANVAS_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
# CANVAS_COURSES_PREVIEW_DIRECTORY=/tmp/cuce-course-previews
# Beta remains Stripe test-only. Omit both for simulated payments.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TARGET_TEST_KEY
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_TARGET_SANDBOX_ENDPOINT_SECRET
# Enable after schema, private storage, backups and renderer validation:
BADGES_ENABLED=false
BADGE_DATA_DIR=/home/data/cuce-credentials
BADGE_LEARNER_MAP_FILE=/home/data/cuce-credentials/portal-learners.json
BADGE_DEMO=true
BADGE_DEMO_PREVIEW=true
# BADGE_CONFIG is omitted for synthetic badges; real credentials need review.
# Launcher supplies CERTIFICATE_PYTHON; do not set BADGE_SERVICE_URL.
NEXT_TELEMETRY_DISABLED=1
SCM_DO_BUILD_DURING_DEPLOYMENT=false
# MIGRATION_DATABASE_URL stays in the migration operator's private environment.
# Configure Always On, TLS, /home persistence and networking as resource settings.

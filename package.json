{
  "name": "continuing-education-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "ts-node -P tsconfig.server.json scripts/db-migrate.ts",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:draft": "ts-node -P tsconfig.server.json scripts/db-draft-migration.ts",
    "db:generate": "prisma generate",
    "db:remove-test-learner": "ts-node -P tsconfig.server.json scripts/remove-test-learner.ts",
    "staff:link-canvas": "ts-node -P tsconfig.server.json scripts/link-canvas-staff.ts",
    "dev": "concurrently -k -n web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:lan": "ts-node -P tsconfig.server.json scripts/dev-lan.ts",
    "dev:web": "next dev src/web --hostname 127.0.0.1 --port 3050",
    "dev:api": "ts-node -P tsconfig.server.json src/server/main.ts",
    "start:web": "next start src/web --hostname 127.0.0.1 --port 3050",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "build": "npm run badges:build && tsc -p tsconfig.server.json && next build src/web",
    "test": "ts-node -P tsconfig.server.json tests/api.integration.ts",
    "test:migrations": "ts-node -P tsconfig.server.json tests/migrations.integration.ts",
    "test:auth": "ts-node -P tsconfig.server.json tests/canvas-auth.integration.ts",
    "test:learner-auth": "ts-node -P tsconfig.server.json tests/learner-auth.integration.ts",
    "test:visibility": "ts-node -P tsconfig.server.json tests/offering-visibility.integration.ts",
    "test:canvas": "ts-node -P tsconfig.server.json tests/canvas-courses.integration.ts",
    "test:a11y": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,json}\"",
    "test:demo": "ts-node -P tsconfig.server.json tests/request-demo.integration.ts",
    "start": "node scripts/start-demo.mjs",
    "package:demo": "node scripts/package-demo.mjs",
    "test:hosting": "ts-node -P tsconfig.server.json tests/hosting.test.ts",
    "verify:demo": "node scripts/verify-demo.mjs",
    "badges:build": "node scripts/build-badge-workspace.mjs",
    "badges:setup": "node scripts/build-badge-workspace.mjs",
    "test:badges": "ts-node -P tsconfig.server.json scripts/test-badges.ts",
    "badges:link-learner": "ts-node -P tsconfig.server.json scripts/link-badge-learner.ts",
    "badges:import-sqlite": "ts-node -P tsconfig.server.json scripts/import-badge-sqlite.ts",
    "test:security": "ts-node -P tsconfig.server.json tests/security.test.ts",
    "test:staff-lookup": "ts-node -P tsconfig.server.json tests/staff-lookup.integration.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "mui-tiptap": "1.31.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "prettier": "3.9.9",
    "prisma": "7.10.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "badge-service"
  ],
  "overrides": {
    "multer": "2.5.0"
  }
}

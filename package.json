{
  "name": "continuing-education-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "ts-node -P tsconfig.server.json scripts/db-migrate.ts",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:draft": "ts-node -P tsconfig.server.json scripts/db-draft-migration.ts",
    "db:generate": "prisma generate",
    "dev": "concurrently -k -n web,api,worker \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:web": "next dev src/web --hostname 127.0.0.1 --port 3000",
    "dev:api": "ts-node -P tsconfig.server.json src/server/main.ts",
    "dev:worker": "ts-node -P tsconfig.server.json src/worker/main.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.server.json && next build src/web",
    "test": "ts-node -P tsconfig.server.json tests/api.integration.ts",
    "test:migrations": "ts-node -P tsconfig.server.json tests/migrations.integration.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}

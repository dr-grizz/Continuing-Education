%% Actual local PostgreSQL schema, through migration 7_featured_explore, verified on October 7, 2026.
%% Since issue #2 the schema is defined in prisma/schema.prisma and migrated by Prisma Migrate
%% (baseline 000_baseline = legacy 001-007; 001_status_enums converts four columns to enums; 002_staff_roles adds staff_members; 003_learner_access adds learner access fields; 006_collections_pathways adds collections, collection_items, saved_courses and pathway_follows; 007_featured_explore adds featured_rank; 008-011 add Stripe orders, sessions, events, refund requests and the refunded status, not drawn here). _prisma_migrations (Prisma history) is not drawn;
%% schema_migrations is kept as read-only legacy history.
%% offering_prices is append-only (update trigger); rows cascade only when their offering is deleted.
%% Only enforced foreign-key relationships are drawn.
%% audit_events.object_id is a polymorphic reference, not an FK.
%% Entitlements have a composite UNIQUE(learner_id, offering_id).
%% commands has a composite PRIMARY KEY(actor, key).
erDiagram
    direction LR
    learners ||--o{ entitlements : registers
    offerings ||--o{ entitlements : grants_access
    entitlements ||--o| orders : has_payment_record
    entitlements ||--o| operations : has_background_workflow
    offerings ||--o{ offering_prices : price_history
    collections ||--o{ collection_items : lists
    offerings ||--o{ collection_items : included_in
    learners ||--o{ saved_courses : saves
    offerings ||--o{ saved_courses : saved_as
    learners ||--o{ pathway_follows : follows
    collections ||--o{ pathway_follows : followed_by

    learners {
        uuid id PK
        text email UK "Normalized; nullable for legacy samples"
        timestamptz created_at
        boolean active "Deactivated learners cannot sign in or act"
        timestamptz deactivated_at "Nullable; CHECK set exactly when inactive"
        integer version
    }
    offerings {
        uuid id PK
        text title
        text category
        text summary
        text description
        jsonb outcomes
        course_type course_type "Enum: cohort, self_paced"
        text format
        date start_date "Required for cohort; null for self_paced"
        date end_date "Required for cohort; null for self_paced"
        integer price_cents
        integer capacity
        boolean approval_required
        integer approval_valid_days "Default 7"
        integer enrollment_close_days "Default 7; Scheduled only"
        text canvas_course_url "Nullable; https only"
        boolean published
        timestamptz unpublished_at "Nullable; set when unpublished"
        integer featured_rank "Nullable; Explore position 1-5, cleared on unpublish"
        integer version
        timestamptz created_at
    }
    entitlements {
        uuid id PK
        uuid learner_id FK "Unique with offering_id"
        uuid offering_id FK "Unique with learner_id"
        entitlement_status status "Enum; includes approval_expired"
        timestamptz reserved_until "Nullable"
        timestamptz approval_expires_at "Nullable"
        integer quoted_price_cents "Nullable; price at reservation"
        timestamptz created_at
    }
    orders {
        uuid id PK
        uuid entitlement_id FK, UK
        integer amount_cents
        text payment_status "Simulated payment"
        timestamptz created_at
    }
    operations {
        uuid id PK
        uuid entitlement_id FK, UK
        operation_status status "Enum: pending, running, succeeded, failed"
        text stage
        timestamptz next_run "Nullable"
        text error "Nullable"
        simulated_outcome simulated_outcome "Enum (prototype): normal, delayed, transient, identity_failure, canvas_failure"
        integer attempts "Automatic attempts at current stage"
        boolean delay_applied
        timestamptz failed_at "Nullable; set when retries are exhausted"
        timestamptz created_at "Nullable"
    }
    commands {
        text actor PK "Composite primary key"
        text key PK "Composite primary key"
        text fingerprint
        jsonb response
    }
    audit_events {
        bigint id PK
        text actor
        text action
        uuid object_id "Nullable; not a foreign key"
        jsonb details
        timestamptz created_at
    }
    offering_prices {
        bigint id PK
        uuid offering_id FK
        integer price_cents
        timestamptz effective_at
        text actor
        text reason "Nullable"
    }
    staff_members {
        uuid id PK
        text email UK "Lowercase; CHECK"
        text display_name
        staff_role_array roles "Enum array; at least one (CHECK)"
        boolean active
        text auth_provider "mock now; SSO add-on later"
        text external_subject "Nullable; unique with auth_provider"
        integer version
        timestamptz created_at
    }
    prototype_settings {
        text key PK "provisioning_outcome"
        text value
        timestamptz updated_at
    }
    schema_migrations {
        text version PK
        timestamptz applied_at "Nullable"
    }
    collections {
        uuid id PK
        collection_kind kind "collection or pathway"
        text slug UK "CHECK lowercase-hyphenated, max 80; fixed at creation"
        text title "CHECK 3-120 characters"
        text summary "CHECK 10-500 characters"
        boolean published
        integer version
        timestamptz created_at
        timestamptz updated_at
        integer featured_rank "Nullable; Explore position 1-3 per kind"
    }
    collection_items {
        uuid collection_id PK,FK
        uuid offering_id PK,FK
        integer position "UNIQUE per collection; CHECK > 0"
    }
    saved_courses {
        uuid learner_id PK,FK
        uuid offering_id PK,FK
        timestamptz created_at
    }
    pathway_follows {
        uuid learner_id PK,FK
        uuid collection_id PK,FK "Service allows kind = pathway only"
        timestamptz created_at
    }

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/server/**/*.ts",
    "src/domain/**/*.ts",
    "src/worker/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}

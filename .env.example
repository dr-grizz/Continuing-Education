PROTOTYPE_MODE=true
DATABASE_URL=postgresql://portal:CHANGE_ME@127.0.0.1:5433/continuing_education
POSTGRES_PASSWORD=CHANGE_ME
API_URL=http://127.0.0.1:3051
LEARNER_API_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
STAFF_API_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
AUTOMATION_API_TOKEN=GENERATE_WITH_NPM_RUN_SETUP

# Staff authentication: mock for the existing local demo, canvas for real staff identities.
# Canvas mode fails closed until configured. These settings belong to the API only.
STAFF_AUTH_MODE=mock
CANVAS_BASE_URL=
CANVAS_STAFF_CLIENT_ID=
CANVAS_STAFF_CLIENT_SECRET=
CANVAS_STAFF_REDIRECT_URI=
CANVAS_USER_AGENT=Cedarville-CE-Portal/0.1.0
# Optional endpoint overrides must use the same Canvas origin.
# CANVAS_STAFF_AUTHORIZE_URL=https://canvas.example.edu/login/oauth2/auth
# CANVAS_STAFF_TOKEN_URL=https://canvas.example.edu/login/oauth2/token
STAFF_SESSION_HOURS=8
CANVAS_STAFF_FORCE_LOGIN=false

# Course reads reuse the staff OAuth key/callback. Enable after adding read scopes.
CANVAS_COURSES_ENABLED=false
# Optional staff-directory search; requires own Canvas account permissions and GET users scope.
# CANVAS_STAFF_LOOKUP_ACCOUNT_ID=1
CANVAS_COURSES_SUBACCOUNT_ID=
CANVAS_COURSES_INCLUDE_SUBACCOUNTS=false
# Optional private temporary directory shared by API and worker; previews expire in 30 minutes.
# CANVAS_COURSES_PREVIEW_DIRECTORY=/private/shared/ce-course-previews
# 32 random bytes, base64-encoded. Server/worker only; keep stable across restarts.
CANVAS_TOKEN_ENCRYPTION_KEY=

# Stripe sandbox (optional; ADR 0005). Test-mode keys only; leave empty for simulated payments.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... (from: stripe listen --all-snapshot --forward-to http://127.0.0.1:3051/api/v1/webhooks/stripe)
# WEB_URL=http://127.0.0.1:3050

# Optional local credential service (see docs/badges-and-certificates.md).
# Tokens are read server-side from BADGE_DATA_DIR; never use NEXT_PUBLIC_ variables.
BADGES_ENABLED=false
BADGE_SERVICE_URL=http://127.0.0.1:4178
BADGE_PORT=4178
BADGE_DATA_DIR=badge-service/data
BADGE_LEARNER_MAP_FILE=badge-service/data/portal-learners.json
# Optional renderer: absolute path to Python with certificate-renderer/requirements.txt installed.
# CERTIFICATE_PYTHON=/absolute/path/to/python3

# Certificate email: disabled until an administrator selects/configures a provider.
CERTIFICATE_EMAIL_FROM=continuinged@cedarville.edu
CERTIFICATE_EMAIL_ENABLED=false
# Supported adapter: resend. Domain/sender verification and credentials are required.
# CERTIFICATE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# Secure links require WEB_URL to be the public HTTPS portal origin.
# QR/claim distribution also uses WEB_URL; localhost is supported for local demos.
# Fictional demo certificates cannot be sent unless explicitly allowed for testing.
CERTIFICATE_EMAIL_ALLOW_DEMO=false

# Optional O*NET Web Services v2. Server-side only; never NEXT_PUBLIC_ or in Git.
# The public /skills explorer retains downloaded data when no key is configured.
# ONET_API_KEY=
